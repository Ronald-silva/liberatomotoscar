# Preencher apenas após configurar as propriedades e validar a medição com a loja.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# URL pública do site. Define a base de og:image, canonical e dados estruturados.
# Na Vercel, defina com o domínio de produção. Sem ela, os deploys de
# pré-visualização caem na URL gerada pela própria Vercel; só o ambiente
# local volta para http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Fase 1: somente no servidor. DATABASE_URL usa pooling no runtime Node;
# DATABASE_URL_DIRECT usa a conexão direta para Drizzle Kit.
# Nunca executar migrações ou importação em produção sem revisão e autorização.
DATABASE_URL=
DATABASE_URL_DIRECT=
# ID público do compute associado ao banco compartilhado com Production.
# Opcional: permite confirmar a conexão ao comparar com as URLs.
NEON_DEVELOPMENT_ENDPOINT_ID=
# Nome legado: use o ID real (br-...) da branch compartilhada com Production,
# mesmo que ela se chame production no Console Neon. Nunca usá-la em teste que grava.
NEON_DEVELOPMENT_BRANCH_ID=
# Somente para ensaios que gravam: projeto e branch Neon isolada (filha da compartilhada).
NEON_PROJECT_ID=
ISOLATED_NEON_TEST_BRANCH_ID=

# Auth.js: Google OAuth da conta do proprietário, sem cadastro público.
# Configure no Google o redirect http://localhost:3000/api/auth/callback/google.
# Nunca use NEXT_PUBLIC_ nestas variáveis.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Uma conta, ou várias separadas por vírgula. Cada conta ainda precisa de concessão em admin_grants.
ADMIN_GOOGLE_EMAIL=
# Ativar somente quando o host de implantação for conhecido e confiável.
AUTH_TRUST_HOST=false

# Bucket privado R2. Nenhuma dessas variáveis deve começar com NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# P1.2: bucket e chave de teste com acesso somente ao bucket de teste.
# Nunca reutilizar R2_BUCKET nem a chave de produção no ensaio destrutivo.
R2_TEST_ACCOUNT_ID=
R2_TEST_BUCKET=
R2_TEST_ACCESS_KEY_ID=
R2_TEST_SECRET_ACCESS_KEY=

# P0: rota administrativa de demonstração. Mantenha false até validar uma
# chamada real ao LLM, a migração demo_ai_usage e os limites do provedor.
DEMO_AI_ENABLED=false
# OpenRouter direto: credencial somente no servidor e limite de consumo na conta.
# Nunca preencher com credenciais de SalesNet, Sofia ou outro cliente.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-pro-0813
